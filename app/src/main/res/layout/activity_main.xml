<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FB"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/layoutRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="32dp">

        <!-- ══ HEADER ══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E3A8A"
            android:paddingHorizontal="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="20dp"
            android:layout_marginHorizontal="-20dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="APP STC"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clasificación de Gestos EMG · NinaPro DB1"
                android:textSize="11sp"
                android:textColor="#A5B8D8"
                android:paddingTop="3dp"
                android:letterSpacing="0.04"/>

        </LinearLayout>

        <!-- ══ TARJETA: CONEXIÓN BLE ══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginTop="20dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONEXIÓN"
                android:textSize="9sp"
                android:textColor="#7B5EA7"
                android:textStyle="bold"
                android:letterSpacing="0.20"
                android:paddingBottom="10dp"/>

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Conectar dispositivo BLE"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1E3A8A"
                android:letterSpacing="0.03"/>

            <!-- Estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_idle"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Listo para conectar"
                    android:textSize="13sp"
                    android:textColor="#4A5568"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ══ TARJETA: SEÑAL EMG ═════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginTop="12dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SEÑAL EMG"
                    android:textSize="9sp"
                    android:textColor="#7B5EA7"
                    android:textStyle="bold"
                    android:letterSpacing="0.20"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="V"
                    android:textSize="9sp"
                    android:textColor="#A0AEC0"
                    android:letterSpacing="0.10"/>

            </LinearLayout>

            <!-- Valores EMG por canal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- CH1 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#F0F4FF"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CH 1"
                        android:textSize="9sp"
                        android:textColor="#7B93B0"
                        android:letterSpacing="0.10"/>

                    <TextView
                        android:id="@+id/tvCh1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="15sp"
                        android:textColor="#1E3A8A"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:paddingTop="2dp"/>

                </LinearLayout>

                <!-- CH2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#F0F4FF"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CH 2"
                        android:textSize="9sp"
                        android:textColor="#7B93B0"
                        android:letterSpacing="0.10"/>

                    <TextView
                        android:id="@+id/tvCh2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="15sp"
                        android:textColor="#1E3A8A"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:paddingTop="2dp"/>

                </LinearLayout>

                <!-- CH3 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#F0F4FF"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CH 3"
                        android:textSize="9sp"
                        android:textColor="#7B93B0"
                        android:letterSpacing="0.10"/>

                    <TextView
                        android:id="@+id/tvCh3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="15sp"
                        android:textColor="#1E3A8A"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:paddingTop="2dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Métricas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="12dp">

                <TextView
                    android:id="@+id/tvSampleCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Muestras: 0"
                    android:textSize="11sp"
                    android:textColor="#718096"
                    android:fontFamily="monospace"/>

                <TextView
                    android:id="@+id/tvFrequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— Hz"
                    android:textSize="11sp"
                    android:textColor="#718096"
                    android:fontFamily="monospace"/>

            </LinearLayout>

            <!-- Campo oculto para mantener compatibilidad con MainActivity.kt -->
            <TextView
                android:id="@+id/tvEMGValues"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"/>


            <!-- Botón Ver Señal — agregar antes del cierre de la tarjeta SEÑAL EMG -->
            <Button
                android:id="@+id/btnGraph"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Ver Señal EMG"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0D9488"
                android:letterSpacing="0.03"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- ══ TARJETA: CLASIFICACIÓN ═════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginTop="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLASIFICACIÓN"
                android:textSize="9sp"
                android:textColor="#7B5EA7"
                android:textStyle="bold"
                android:letterSpacing="0.20"
                android:paddingBottom="14dp"/>

            <!-- Resultado principal -->
            <TextView
                android:id="@+id/tvPrediction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="32sp"
                android:textColor="#1E3A8A"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingVertical="16dp"
                android:background="#F0F4FF"/>

        </LinearLayout>

        <!-- ══ BOTÓN DESCONECTAR ══════════════════════════════════════════════ -->
        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Detener recepción"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7B5EA7"
            android:letterSpacing="0.03"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:alpha="0.45"/>

        <!-- ══ FOOTER ══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pontificia Universidad Javeriana Cali"
                android:textSize="10sp"
                android:textColor="#A0AEC0"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
